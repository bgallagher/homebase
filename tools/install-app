#!/bin/bash
# Build Rackoon and install it into /Applications.
#   usage: tools/install-app [--dev] [version]
# Without --dev this installs the stable "Rackoon.app"; with it, "Rackoon Dev.app" (caution-tape icon) beside it.
# The app is ad-hoc signed and built on this Mac, so it opens without the right-click-Open step. Quit it first.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
name="Rackoon"
dev=()
rest=()
for arg in "$@"; do
  if [ "$arg" = "--dev" ]; then name="Rackoon Dev"; dev=(--dev); else rest+=("$arg"); fi
done
# make-app only reads --dev as its first argument
"$root/tools/make-app" ${dev[@]+"${dev[@]}"} ${rest[@]+"${rest[@]}"}
src="$root/build/$name.app"
dest="/Applications/$name.app"
if pgrep -f "$dest/Contents/MacOS/RackoonMac" >/dev/null 2>&1; then
  echo "$name is running: quit it, then run this again." >&2
  exit 1
fi
rm -rf "$dest"
ditto "$src" "$dest"
echo "installed $dest"
