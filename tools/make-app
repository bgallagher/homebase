#!/bin/bash
# Build an unsigned (ad-hoc signed) Rackoon.app into build/. Signing and notarizing for distribution need
# an Apple Developer account and are not done here.
#   usage: tools/make-app [--dev] [version]      version defaults to 0.1.0
# --dev builds "Rackoon Dev.app" (bundle id com.bgallagher.rackoon.dev) with the caution-tape icon, so it can sit next to
# the installed stable Rackoon.app and be told apart in the Dock and the app switcher. Both read the same saved servers.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
dev=0
if [ "${1:-}" = "--dev" ]; then dev=1; shift; fi
version="${1:-0.1.0}"
build_number="$(git -C "$root" rev-list --count HEAD 2>/dev/null || echo 1)"
if [ "$dev" = 1 ]; then
  app_name="Rackoon Dev"
  bundle_id="com.bgallagher.rackoon.dev"
  icon_png="$root/apple/Apps/RackoonMac/Resources/rackoon-icon-dev.png"
  version="$version-dev"
  url_scheme="rackoon-dev"
else
  app_name="Rackoon"
  bundle_id="com.bgallagher.rackoon"
  icon_png="$root/apple/Apps/RackoonMac/Resources/rackoon-icon.png"
  url_scheme="rackoon"
fi
out="$root/build/$app_name.app"

cd "$root/apple"
swift build -c release --product RackoonMac
swift build -c release --product rackoon-pty
bin="$(swift build -c release --show-bin-path)"

rm -rf "$out"
mkdir -p "$out/Contents/MacOS" "$out/Contents/Resources"
cp "$bin/RackoonMac" "$out/Contents/MacOS/RackoonMac"
cp "$bin/rackoon-pty" "$out/Contents/MacOS/rackoon-pty"          # the relay must sit next to the app executable
cp -R "$bin/Rackoon_RackoonMac.bundle" "$out/Contents/Resources/"   # themes + artwork (SwiftPM resource bundle)

iconset="$root/build/AppIcon.iconset"
rm -rf "$iconset"
swift "$root/tools/make-icns.swift" "$icon_png" "$iconset"
iconutil -c icns "$iconset" -o "$out/Contents/Resources/AppIcon.icns"
rm -rf "$iconset"

cat > "$out/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>RackoonMac</string>
  <key>CFBundleIdentifier</key><string>$bundle_id</string>
  <key>CFBundleName</key><string>$app_name</string>
  <key>CFBundleDisplayName</key><string>$app_name</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$build_number</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <!-- The Paddle hosted checkout redirects here after a purchase (rackoon://purchase-complete); dev and stable builds
       use different schemes so they never fight over the link. -->
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>$bundle_id</string>
    <key>CFBundleURLSchemes</key><array><string>$url_scheme</string></array>
  </dict></array>
  <key>NSHumanReadableCopyright</key><string>© 2026 Brian Gallagher</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <!-- Bookmarks fetch each site's favicon, often from plain http addresses on a home network or Tailscale. -->
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/></dict>
</dict>
</plist>
PLIST
plutil -lint "$out/Contents/Info.plist" >/dev/null

# Sign inside-out without the deprecated --deep: the relay first, then the app. Any failure stops the script.
# --options runtime (hardened runtime): blocks code injection such as DYLD_INSERT_LIBRARIES, so another program can't run
# inside Rackoon and ask for a saved sudo password in its name. SudoVault only offers "Remember on this Mac" when it's on.
codesign --force --options runtime --sign - "$out/Contents/MacOS/rackoon-pty"
codesign --force --options runtime --sign - "$out"
codesign --verify --strict --verbose=2 "$out"
echo "built $out (version $version, build $build_number)"
