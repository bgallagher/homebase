{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rackoon models",
  "$defs": {
    "Server": {
      "type": "object",
      "required": [
        "id",
        "name",
        "host"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "sshConfigAlias": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "description": "host is what ssh connects to: a hostname, an IP or a ~/.ssh/config alias. sshConfigAlias is set when imported from ssh config."
    },
    "Overview": {
      "type": "object",
      "required": [
        "hostname",
        "os",
        "uptimeSeconds",
        "load1",
        "load5",
        "load15",
        "cores",
        "cpu",
        "memory",
        "disks",
        "rebootRequired",
        "unhealthyContainers",
        "pendingUpdates",
        "securityUpdates"
      ],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "object",
          "required": [
            "id",
            "name",
            "version",
            "prettyName"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "prettyName": {
              "type": "string"
            }
          }
        },
        "uptimeSeconds": {
          "type": "number"
        },
        "load1": {
          "type": "number"
        },
        "load5": {
          "type": "number"
        },
        "load15": {
          "type": "number"
        },
        "cores": {
          "type": "integer"
        },
        "cpu": {
          "type": "object",
          "description": "Cumulative /proc/stat counters: total = user..steal, idle = idle+iowait",
          "required": [
            "total",
            "idle"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "idle": {
              "type": "integer"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "totalBytes",
            "availableBytes"
          ],
          "properties": {
            "totalBytes": {
              "type": "integer"
            },
            "availableBytes": {
              "type": "integer"
            }
          }
        },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "filesystem",
              "mount",
              "totalBytes",
              "usedBytes",
              "usePercent"
            ],
            "properties": {
              "filesystem": {
                "type": "string"
              },
              "mount": {
                "type": "string"
              },
              "totalBytes": {
                "type": "integer"
              },
              "usedBytes": {
                "type": "integer"
              },
              "usePercent": {
                "type": "integer"
              }
            }
          }
        },
        "rebootRequired": {
          "type": "boolean"
        },
        "unhealthyContainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "securityUpdates": {
          "type": "integer",
          "description": "Packages apt can upgrade from a security suite (0 if apt is absent)."
        },
        "pendingUpdates": {
          "type": "integer",
          "description": "Packages apt can upgrade, from apt's local cache (0 if apt is absent)."
        }
      }
    },
    "AttentionItem": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "message",
        "fix"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        }
      }
    },
    "DockerSnapshot": {
      "type": "object",
      "required": [
        "containers"
      ],
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "image",
              "state",
              "health",
              "status",
              "ports"
            ],
            "description": "Optional fields are omitted (not null) when unknown. Stacks are derived from `project`.",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "running",
                  "exited",
                  "paused",
                  "restarting",
                  "created",
                  "removing",
                  "dead"
                ]
              },
              "health": {
                "enum": [
                  "none",
                  "starting",
                  "healthy",
                  "unhealthy"
                ]
              },
              "status": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "hostPort",
                    "containerPort",
                    "proto"
                  ],
                  "properties": {
                    "hostPort": {
                      "type": "integer"
                    },
                    "containerPort": {
                      "type": "integer"
                    },
                    "proto": {
                      "type": "string"
                    }
                  }
                }
              },
              "project": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "workingDir": {
                "type": "string"
              },
              "configFile": {
                "type": "string"
              },
              "cpuPercent": {
                "type": "number"
              },
              "memoryUsedBytes": {
                "type": "integer"
              },
              "memoryLimitBytes": {
                "type": "integer"
              },
              "configFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "All compose files from the config_files label, in order. configFile is the first."
              },
              "bookmark": {
                "type": "object",
                "description": "From the container's Homepage-convention labels (gethomepage.dev): homepage.href, homepage.name, homepage.group, homepage.icon, homepage.description. Present only when homepage.href is a valid http(s) URL; empty optional fields are omitted. Other homepage.* labels are ignored.",
                "required": [
                  "href"
                ],
                "properties": {
                  "href": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "group": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "UpdatesSnapshot": {
      "type": "object",
      "required": [
        "packages",
        "held",
        "rebootRequired"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "suite",
              "newVersion",
              "architecture",
              "isSecurity"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "suite": {
                "type": "string",
                "description": "apt's suite list, e.g. noble-updates,noble-security"
              },
              "newVersion": {
                "type": "string"
              },
              "oldVersion": {
                "type": "string"
              },
              "architecture": {
                "type": "string"
              },
              "isSecurity": {
                "type": "boolean",
                "description": "true when any suite ends in -security"
              }
            }
          }
        },
        "held": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refreshedAt": {
          "type": "integer",
          "description": "Unix time the package lists were last refreshed, when known"
        },
        "rebootRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
