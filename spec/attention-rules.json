{
  "version": 1,
  "rules": [
    {
      "id": "disk_high",
      "severity": "warning",
      "severityCritical": "usePercent >= 95",
      "condition": "any filesystem usePercent > 85",
      "message": "{mount} is {usePercent}% full.",
      "fix": "docker"
    },
    {
      "id": "reboot_required",
      "severity": "warning",
      "condition": "rebootRequired is true",
      "message": "A reboot is required to finish applying updates.",
      "fix": "updates"
    }
  ]
}
