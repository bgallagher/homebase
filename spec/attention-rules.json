{
  "version": 1,
  "rules": [
    {
      "id": "disk_high",
      "severity": "warning",
      "severityCritical": "usePercent >= 95",
      "condition": "any filesystem usePercent > 85",
      "message": "{mount} is {usePercent}% full.",
      "fix": "docker"
    },
    {
      "id": "container_unhealthy",
      "severity": "warning",
      "condition": "each name in unhealthyContainers",
      "message": "{name} is unhealthy.",
      "fix": "docker"
    },
    {
      "id": "security_updates",
      "severity": "warning",
      "condition": "securityUpdates > 0",
      "message": "{n} security update(s) are available.",
      "fix": "updates"
    },
    {
      "id": "reboot_required",
      "severity": "warning",
      "condition": "rebootRequired is true",
      "message": "A reboot is required to finish applying updates.",
      "fix": "updates"
    }
  ]
}
